# Replace the database password in both fields before starting Compose.
POSTGRES_PASSWORD=replace_with_local_password
DATABASE_URL=postgresql+psycopg://scout:replace_with_local_password@db:5432/scout
CORS_ORIGINS=http://localhost:5173

# Groq: leave the API key empty to use rule-based fallback.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b

# Local MiniLM is optional. Set true only when the model is available.
EMBEDDINGS_ENABLED=false
EMBEDDING_PROVIDER=local

# Optional hosted embeddings: set EMBEDDING_PROVIDER=openai and provide a separate key.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
